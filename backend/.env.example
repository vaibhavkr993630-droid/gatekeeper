# Copy to .env for local dev
SECRET_KEY=dev-secret-change-me
ADMIN_SECRET_KEY=dev-admin-secret-change-me
DATABASE_URL=postgresql+asyncpg://gatekeeper:gatekeeper@localhost:5432/gatekeeper
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- hardening (Phase 7) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false                 # true in containers/production — one JSON object per line
SENTRY_DSN=                    # unset = error tracking disabled
SENTRY_TRACES_SAMPLE_RATE=0.0
BLOCK_PRIVATE_UPSTREAMS=false  # true in production — rejects loopback/private upstream_url
